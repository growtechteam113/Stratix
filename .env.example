# ============================================================================
# STRATIX AI - Environment Variables Template
# Copy this file to .env and fill in your local/production values
# ============================================================================

# --- Global Environment ---
NODE_ENV=development

# --- Database (PostgreSQL with pgvector) ---
# Local: postgresql://user:password@localhost:5432/stratix?schema=public
# Railway: provided by Railway
DATABASE_URL="postgresql://user:password@localhost:5432/stratix?schema=public"

# --- Redis (BullMQ Queue) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# --- OpenAI API ---
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Backend API (NestJS) ---
PORT=3001
API_HOST="0.0.0.0"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"
FRONTEND_URL="http://localhost:3000"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="STRATIX AI"

# --- Admin Settings ---
ADMIN_EMAIL="admin@stratix.ai"
ADMIN_PASSWORD="change-me-in-production"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL="debug"
